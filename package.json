    "smoke": "node scripts/smoke.mjs",
    "smoke:scan": "node scripts/smoke.mjs --scan"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.64.1",
    "typescript": "5.8.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5"
  }
}
