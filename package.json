    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "playwright": "^1.49.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
