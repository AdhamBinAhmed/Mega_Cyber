{
  "name": "megadevs-passive-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Passive website security scanner — MEGA Devs Cyber Team",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
