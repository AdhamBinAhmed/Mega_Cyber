# ---------------------------------------------------------------------------
# MEGA Devs Passive Scanner — environment
# Every value is optional; the scanner runs with sane defaults out of the box.
# ---------------------------------------------------------------------------

# Origins allowed to <iframe> the scanner (space separated).
# Unset => frame-ancestors 'none'.
EMBED_ANCESTORS="https://megadevs.example https://www.megadevs.example"

# --- SSL Labs -------------------------------------------------------------
# API v3 needs no key but is being retired. API v4 is free but requires a
# one-time email registration: https://api.ssllabs.com/api/v4/register
# Set SSLLABS_EMAIL (and optionally SSLLABS_API_KEY) to use v4.
SSLLABS_API_VERSION="v3"
SSLLABS_EMAIL=""
SSLLABS_API_KEY=""
# Accept an SSL Labs cached result up to N hours old (keeps scans fast + polite).
SSLLABS_MAX_AGE_HOURS="24"
# How long a scan waits for SSL Labs before handing the dashboard a pending
# section to poll. A cold SSL Labs scan takes 1-3 minutes, far longer than a
# serverless invocation should stay open.
SSLLABS_INITIAL_WAIT_MS="6000"
# Set to "off" to disable the SSL Labs call entirely (local TLS inspection only).
SSLLABS_ENABLED="on"

# --- Local TLS inspection -------------------------------------------------
# "on"  => open a TLS handshake to the target's 443 to read the certificate
#          and detect which protocol versions it negotiates.
# "cert" => certificate only, no protocol-version probing.
# "off" => no direct TLS connection at all.
TLS_LOCAL_PROBE="on"

# --- Local development ----------------------------------------------------
# Allow scanning private/loopback targets (your own site on localhost) and any
# port. Needed because the SSRF guard otherwise refuses them.
#
# This is IGNORED when NODE_ENV=production, so setting it on a deployed
# instance does nothing. Use it in .env.local only.
# ALLOW_PRIVATE_TARGETS="1"

# --- Rate limiting --------------------------------------------------------
# In-memory, per serverless instance. For production put Upstash/Redis in front.
#
# Only active when NODE_ENV=production: throttling your own dev server locks you
# out of your own tool, and a direct localhost request has no x-forwarded-for,
# so every local caller would share a single bucket.
#
# Set RATE_LIMIT_MAX=0 to disable it in production too (e.g. when something in
# front of the app already does the limiting).
RATE_LIMIT_MAX="30"
RATE_LIMIT_WINDOW_SECONDS="600"

# --- Scanner budgets ------------------------------------------------------
SCAN_REQUEST_TIMEOUT_MS="8000"
SCAN_TOTAL_BUDGET_MS="25000"
# Hard cap on how much of any response body is read into memory.
SCAN_MAX_BODY_BYTES="524288"
# Redirect hops to follow, each one re-validated against the SSRF guard.
SCAN_MAX_REDIRECTS="5"
# Parallel requests during the exposed-files sweep. Deliberately gentle.
SCAN_EXPOSURE_CONCURRENCY="3"
